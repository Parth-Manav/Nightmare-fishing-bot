# ============================================================
# Stardust Pond Bot — Environment Configuration
# Copy this file to .env and fill in your values.
# Required values must be set. Optional values have defaults.
# ============================================================

# ── Required ─────────────────────────────────────────────────
# Your Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_token_here

# ── Optional: Logging ─────────────────────────────────────────
# Log level for the bot. Options: error, warn, info, debug, trace
# Use RUST_LOG=stardust_pond_bot=debug for verbose output during development
# Default: info
LOG_LEVEL=info

# ── Optional: Persistence ─────────────────────────────────────
# Path to the JSON file where fishing data is stored
# Default: fishing_data.json (in the working directory)
DATA_PATH=fishing_data.json

# Directory where rotating backups are stored
# Default: backups/
BACKUP_DIR=backups/

# Number of backup files to keep before rotating (oldest is deleted)
# Default: 5
MAX_BACKUPS=5

# ── Optional: Scheduling ──────────────────────────────────────
# UTC hour for the daily fishing reset (0–23)
# Default: 14 (2:00 PM UTC)
RESET_HOUR=14

# UTC minute for the daily fishing reset (0–59)
# Default: 30 (making the reset time 14:30 UTC)
RESET_MINUTE=30
